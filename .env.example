# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB — primary application database
# Local default:
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=tourops

# Demo staff (python manage.py seed_demo_user)
DEMO_OWNER_EMAIL=owner@tourops.local
DEMO_OWNER_PASSWORD=changeme
DEMO_AGENT_EMAIL=agent@tourops.local
DEMO_AGENT_PASSWORD=changeme
DEMO_ACCOUNTANT_EMAIL=accountant@tourops.local
DEMO_ACCOUNTANT_PASSWORD=changeme

# Optional: Atlas example
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
